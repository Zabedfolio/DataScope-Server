PORT=5000

# DATABASE_URL can point to a Supabase Postgres instance
# Note: Use the direct or session connection string for migrations, not the transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datascope
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/datascope

BETTER_AUTH_SECRET=replace_with_a_secure_random_string_at_least_32_chars
BETTER_AUTH_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

